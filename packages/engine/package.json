{
  "name": "@tax-form-layer/engine",
  "version": "0.1.0",
  "description": "Renderer-agnostic engine that resolves annotation bindings, formats values, computes layout, and produces filled PDFs/images from a FormTemplate + data set.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./src/renderers/pdf.ts",
    "./png": "./src/renderers/png.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@tax-form-layer/spec": "workspace:*",
    "jsonpath-plus": "^10.2.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}

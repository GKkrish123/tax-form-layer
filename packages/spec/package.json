{
  "name": "@tax-form-layer/spec",
  "version": "0.1.0",
  "description": "Medium-agnostic annotation specification for U.S. tax form boxes: TypeScript types, Zod runtime schema, JSON Schema generation, and version migrations.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema.json": "./generated/annotation.schema.json",
    "./examples/w2-2024": "./examples/w2-2024.annotation.json",
    "./examples/w4-2024": "./examples/w4-2024.annotation.json",
    "./examples/w9-2024": "./examples/w9-2024.annotation.json",
    "./examples/1099-nec-2024": "./examples/1099-nec-2024.annotation.json",
    "./examples/1099-int-2024": "./examples/1099-int-2024.annotation.json",
    "./examples/1099-misc-2024": "./examples/1099-misc-2024.annotation.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "generated",
    "examples"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "schema:gen": "tsx scripts/generate-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}

{
  "specVersion": "1.1.0",
  "id": "irs-w2-2024",
  "title": "IRS Form W-2 (2024) — Wage and Tax Statement",
  "templateVersion": "1.1.0",
  "form": {
    "jurisdiction": "US-IRS",
    "formNumber": "W-2",
    "taxYear": 2024,
    "edition": "2024"
  },
  "medium": {
    "kind": "pdf",
    "source": "/forms/w2-2024.pdf",
    "dpi": 150
  },
  "pageSize": { "width": 612, "height": 792 },
  "metadata": {
    "author": "tax-form-layer",
    "description": "Reference annotation: computed wages, statutory radios, Copy B/C pack, state-row overflow statement, and dataset fixtures.",
    "tags": ["w2", "wages", "reference"]
  },
  "copies": [
    {
      "id": "B",
      "title": "Copy B — To Be Filed With Employee's FEDERAL Tax Return",
      "pageFilter": [1]
    },
    {
      "id": "C",
      "title": "Copy C — For EMPLOYEE'S RECORDS",
      "pageFilter": [1]
    }
  ],
  "pages": [
    {
      "number": 1,
      "backgroundRef": 0,
      "fields": [
        {
          "type": "value",
          "id": "employee_ssn",
          "label": "Box a — Employee's SSN",
          "boxNumber": "a",
          "required": true,
          "rect": { "x": 0.05, "y": 0.06, "width": 0.32, "height": 0.03 },
          "binding": { "source": "jsonpath", "path": "$.employee.ssn" },
          "format": { "type": "ssn" },
          "style": { "fontSize": 10, "align": "left" }
        },
        {
          "type": "value",
          "id": "employer_ein",
          "label": "Box b — Employer EIN",
          "boxNumber": "b",
          "rect": { "x": 0.05, "y": 0.12, "width": 0.32, "height": 0.03 },
          "binding": { "source": "jsonpath", "path": "$.employer.ein" },
          "format": { "type": "ein" },
          "style": { "fontSize": 10 }
        },
        {
          "type": "value",
          "id": "employer_block",
          "label": "Box c — Employer name & address",
          "boxNumber": "c",
          "rect": { "x": 0.05, "y": 0.17, "width": 0.4, "height": 0.09 },
          "binding": {
            "source": "template",
            "template": "{$.employer.name}\n{$.employer.address.street}\n{$.employer.address.city}, {$.employer.address.state} {$.employer.address.zip}"
          },
          "format": { "type": "text" },
          "style": { "fontSize": 9, "verticalAlign": "top", "overflow": "wrap" }
        },
        {
          "type": "value",
          "id": "employee_name",
          "label": "Box e — Employee name",
          "boxNumber": "e",
          "rect": { "x": 0.05, "y": 0.3, "width": 0.4, "height": 0.03 },
          "binding": {
            "source": "template",
            "template": "{$.employee.firstName} {$.employee.lastName}"
          },
          "format": { "type": "text", "case": "upper" },
          "style": { "fontSize": 10 }
        },
        {
          "type": "value",
          "id": "box1_wages",
          "label": "Box 1 — Wages, tips, other comp.",
          "boxNumber": "1",
          "rect": { "x": 0.5, "y": 0.06, "width": 0.22, "height": 0.03 },
          "binding": {
            "source": "computed",
            "op": "sum",
            "args": [
              { "source": "jsonpath", "path": "$.wages.base" },
              { "source": "jsonpath", "path": "$.wages.tips" }
            ]
          },
          "format": { "type": "currency" },
          "style": { "align": "right", "fontSize": 10 }
        },
        {
          "type": "value",
          "id": "box2_fed_withheld",
          "label": "Box 2 — Federal income tax withheld",
          "boxNumber": "2",
          "rect": { "x": 0.75, "y": 0.06, "width": 0.22, "height": 0.03 },
          "binding": { "source": "jsonpath", "path": "$.boxes.box2", "fallback": 0 },
          "format": { "type": "currency" },
          "style": { "align": "right", "fontSize": 10 }
        },
        {
          "type": "value",
          "id": "box3_ss_wages",
          "label": "Box 3 — Social security wages",
          "boxNumber": "3",
          "rect": { "x": 0.5, "y": 0.12, "width": 0.22, "height": 0.03 },
          "binding": { "source": "jsonpath", "path": "$.boxes.box3", "fallback": 0 },
          "format": { "type": "currency" },
          "style": { "align": "right", "fontSize": 10 }
        },
        {
          "type": "value",
          "id": "box4_ss_withheld",
          "label": "Box 4 — Social security tax withheld",
          "boxNumber": "4",
          "rect": { "x": 0.75, "y": 0.12, "width": 0.22, "height": 0.03 },
          "binding": { "source": "jsonpath", "path": "$.boxes.box4", "fallback": 0 },
          "format": { "type": "currency" },
          "style": { "align": "right", "fontSize": 10 }
        },
        {
          "type": "checkbox",
          "id": "box13_retirement",
          "label": "Box 13 — Retirement plan",
          "boxNumber": "13",
          "rect": { "x": 0.5, "y": 0.3, "width": 0.02, "height": 0.02 },
          "binding": { "source": "jsonpath", "path": "$.boxes.box13.retirementPlan" },
          "mark": "cross"
        },
        {
          "type": "radio",
          "id": "statutory_yes",
          "label": "Statutory employee — Yes",
          "group": "statutory",
          "option": true,
          "rect": { "x": 0.54, "y": 0.34, "width": 0.02, "height": 0.02 },
          "binding": { "source": "jsonpath", "path": "$.boxes.box13.statutoryEmployee" },
          "mark": "cross"
        },
        {
          "type": "radio",
          "id": "statutory_no",
          "label": "Statutory employee — No",
          "group": "statutory",
          "option": false,
          "rect": { "x": 0.62, "y": 0.34, "width": 0.02, "height": 0.02 },
          "binding": { "source": "jsonpath", "path": "$.boxes.box13.statutoryEmployee" },
          "mark": "cross"
        },
        {
          "type": "value",
          "id": "state_see_stmt",
          "label": "See statement",
          "rect": { "x": 0.05, "y": 0.94, "width": 0.4, "height": 0.02 },
          "binding": { "source": "const", "value": "" },
          "format": { "type": "text" },
          "style": { "fontSize": 8, "color": "#334155" }
        },
        {
          "type": "repeat",
          "id": "state_rows",
          "label": "Boxes 15-17 — State tax (repeating)",
          "rect": { "x": 0.05, "y": 0.85, "width": 0.9, "height": 0.03 },
          "itemsPath": "$.state",
          "rowHeight": 0.035,
          "maxRows": 2,
          "overflow": {
            "strategy": "statement",
            "statementText": "See attached",
            "statementFieldId": "state_see_stmt"
          },
          "fields": [
            {
              "type": "value",
              "id": "state_code",
              "boxNumber": "15",
              "rect": { "x": 0, "y": 0, "width": 0.08, "height": 0.03 },
              "binding": { "source": "jsonpath", "path": "@.code" },
              "format": { "type": "text", "case": "upper" }
            },
            {
              "type": "value",
              "id": "state_wages",
              "boxNumber": "16",
              "rect": { "x": 0.3, "y": 0, "width": 0.25, "height": 0.03 },
              "binding": { "source": "jsonpath", "path": "@.wages", "fallback": 0 },
              "format": { "type": "currency" },
              "style": { "align": "right" }
            },
            {
              "type": "value",
              "id": "state_tax",
              "boxNumber": "17",
              "rect": { "x": 0.6, "y": 0, "width": 0.25, "height": 0.03 },
              "binding": { "source": "jsonpath", "path": "@.tax", "fallback": 0 },
              "format": { "type": "currency" },
              "style": { "align": "right" }
            }
          ]
        }
      ]
    }
  ],
  "sampleData": {
    "employee": {
      "firstName": "Jordan",
      "lastName": "Rivera",
      "ssn": "123456789"
    },
    "employer": {
      "name": "Acme Robotics, Inc.",
      "ein": "981234567",
      "address": {
        "street": "500 Innovation Way",
        "city": "Palo Alto",
        "state": "CA",
        "zip": "94304"
      }
    },
    "wages": { "base": 80000, "tips": 4250.75 },
    "boxes": {
      "box2": 12630.11,
      "box3": 84250.75,
      "box4": 5223.55,
      "box13": { "retirementPlan": true, "statutoryEmployee": false }
    },
    "state": [
      { "code": "CA", "wages": 84250.75, "tax": 4102.33 },
      { "code": "NY", "wages": 0, "tax": 0 }
    ]
  },

{
  "specVersion": "1.1.0",
  "id": "irs-1099-int-2024",
  "title": "IRS Form 1099-INT (2024) — Interest Income",
  "templateVersion": "1.0.0",
  "form": {
    "jurisdiction": "US-IRS",
    "formNumber": "1099-INT",
    "taxYear": 2024,
    "edition": "2024"
  },
  "medium": {
    "kind": "pdf",
    "source": "/forms/1099-int-2024.pdf",
    "dpi": 150
  },
  "pageSize": { "width": 612, "height": 792 },
  "metadata": {
    "author": "tax-form-layer",
    "description": "1099-INT: payer/recipient blocks, interest and withheld currency, 2nd TIN checkbox.",
    "tags": ["1099", "interest", "reference"]
  },
  "pages": [
    {
      "number": 1,
      "backgroundRef": 0,
      "fields": [
        {
          "type": "value",
          "id": "payer_block",
          "label": "PAYER'S name, address, TIN",
          "rect": { "x": 0.05, "y": 0.08, "width": 0.48, "height": 0.12 },
          "binding": {
            "source": "template",
            "template": "{$.payer.name}\n{$.payer.address}\nTIN {$.payer.tin}"
          },
          "format": { "type": "text" },
          "style": { "fontSize": 9, "verticalAlign": "top", "overflow": "wrap" }
        },
        {
          "type": "comb",
          "id": "recipient_tin",
          "label": "RECIPIENT'S TIN",
          "rect": { "x": 0.56, "y": 0.08, "width": 0.38, "height": 0.03 },
          "binding": { "source": "jsonpath", "path": "$.recipient.tin" },
          "format": { "type": "ssn" },
          "cells": 9,
          "cellGap": 0.08,
          "alignRight": false,
          "style": { "fontSize": 11, "align": "center" }
        },
        {
          "type": "value",
          "id": "recipient_name",
          "label": "RECIPIENT'S name",
          "rect": { "x": 0.05, "y": 0.24, "width": 0.48, "height": 0.04 },
          "binding": { "source": "jsonpath", "path": "$.recipient.name" },
          "format": { "type": "text", "case": "upper" },
          "style": { "fontSize": 10 }
        },
        {
          "type": "value",
          "id": "box1_interest",
          "label": "1 — Interest income",
          "boxNumber": "1",
          "rect": { "x": 0.56, "y": 0.18, "width": 0.38, "height": 0.04 },
          "binding": { "source": "jsonpath", "path": "$.amounts.interest", "fallback": 0 },
          "format": { "type": "currency" },
          "style": { "align": "right", "fontSize": 11 }
        },
        {
          "type": "value",
          "id": "box4_withheld",
          "label": "4 — Federal income tax withheld",
          "boxNumber": "4",
          "rect": { "x": 0.56, "y": 0.26, "width": 0.38, "height": 0.04 },
          "binding": { "source": "jsonpath", "path": "$.amounts.federalWithheld", "fallback": 0 },
          "format": { "type": "currency" },
          "style": { "align": "right", "fontSize": 11 }
        },
        {
          "type": "value",
          "id": "box8_tax_exempt",
          "label": "8 — Tax-exempt interest",
          "boxNumber": "8",
          "rect": { "x": 0.56, "y": 0.34, "width": 0.38, "height": 0.04 },
          "binding": { "source": "jsonpath", "path": "$.amounts.taxExempt", "fallback": 0 },
          "format": { "type": "currency" },
          "style": { "align": "right", "fontSize": 11 }
        },
        {
          "type": "checkbox",
          "id": "second_tin",
          "label": "2nd TIN not.",
          "rect": { "x": 0.56, "y": 0.42, "width": 0.02, "height": 0.02 },
          "binding": { "source": "jsonpath", "path": "$.flags.secondTinNotice" },
          "mark": "text",
          "markText": "X"
        }
      ]
    }
  ],
  "sampleData": {
    "payer": {
      "name": "First National Credit Union",
      "address": "100 Main Street, Denver, CO 80202",
      "tin": "840012223"
    },
    "recipient": {
      "name": "Jordan Rivera",
      "tin": "123456789"
    },
    "amounts": {
      "interest": 412.88,
      "federalWithheld": 0,
      "taxExempt": 18.5
    },
    "flags": {
      "secondTinNotice": false
    }
  }
}

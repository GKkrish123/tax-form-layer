{
  "name": "tax-form-layer",
  "version": "0.1.0",
  "private": true,
  "description": "A medium-agnostic annotation spec for U.S. tax form boxes, plus a reference rendering engine and visual editor.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:all": "pnpm -r build",
    "dev": "pnpm --filter @tax-form-layer/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "schema:gen": "pnpm --filter @tax-form-layer/spec schema:gen"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
